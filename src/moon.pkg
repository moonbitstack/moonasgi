// The facade: re-exports spec, http, ws, lifespan, client and conform, so one
// import is the whole seam. `mid` and `testing` stay out of it, since they bring
// a compression package and an event loop with them.
//
// https://asgi.readthedocs.io/en/latest/specs/main.html
import {
  "moonbitstack/moonasgi/spec",
  "moonbitstack/moonasgi/http",
  "moonbitstack/moonasgi/ws",
  "moonbitstack/moonasgi/lifespan",
  "moonbitstack/moonasgi/client",
  "moonbitstack/moonasgi/conform",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonasgi/spec",
  "moonbitstack/moonasgi/http",
  "moonbitstack/moonasgi/client",
  "moonbitstack/moonasgi/conform",
} for "test"
