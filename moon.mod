name = "moonbitstack/moonasgi"

version = "0.11.2"

readme = "README.md"

source = "src"

repository = "https://github.com/moonbitstack/moonasgi"

license = "Apache-2.0"

keywords = [
  "asgi",
  "asgi3",
  "wsgi",
  "web",
  "server",
  "http",
  "websocket",
  "lifespan",
  "middleware",
  "ratelimit",
  "rate-limit",
  "quota",
  "throttle",
  "retry-after",
  "structured-fields",
  "session",
  "authentication",
  "authorization",
  "cookie",
  "hmac",
  "redirect",
  "interface",
  "protocol",
  "testing",
  "test-client",
  "conformance",
  "http2",
  "http3",
  "cgi",
  "framework",
  "async",
  "starlette",
  "moonbit",
]

description = "ASGI 3.0 for MoonBit: the interface between servers and frameworks."

import {
  "moonbitstack/moonzip@0.3.8",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.5.0",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/mooncrypt@0.5.0",
  "moonbitstack/moondate@0.1.7",
  "moonbitstack/moonregex@0.2.0",
  "moonbitstack/moonward@0.2.3",
  "moonbitstack/moonurl@0.2.6",
}
