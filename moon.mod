name = "moonbitstack/moonasgi"

version = "0.10.7"

readme = "README.md"

source = "src"

repository = "https://github.com/moonbitstack/moonasgi"

license = "Apache-2.0"

keywords = [
  "asgi",
  "asgi3",
  "wsgi",
  "web",
  "server",
  "http",
  "websocket",
  "lifespan",
  "middleware",
  "session",
  "authentication",
  "authorization",
  "cookie",
  "hmac",
  "redirect",
  "interface",
  "protocol",
  "testing",
  "test-client",
  "conformance",
  "http2",
  "http3",
  "cgi",
  "framework",
  "async",
  "starlette",
  "moonbit",
]

description = "ASGI 3.0 for MoonBit: the interface between servers and frameworks."

import {
  "moonbitstack/moonzip@0.3.7",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonbase@0.4.3",
  "moonbitstack/mooncrypt@0.4.12",
  "moonbitstack/moondate@0.1.5",
  "moonbitstack/moonregex@0.1.3",
  "moonbitstack/moonward@0.2.1",
  "moonbitstack/moonurl@0.2.5",
}
